[Unit]
Description=GeoProxy VPS proxy (sing-box)
Documentation=https://github.com/vistone/geoproxy-server
After=network-online.target
Wants=network-online.target
# RestartSec=3 时默认 10s/5 次限速永不触发（窗口内最多 4 次启动），
# 会形成无限 3 秒重启风暴；放宽窗口并限次，风暴有界后进入 failed 便于告警
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
ExecStartPre=+__BIN__ mesh ensure
ExecStart=__CORE_BIN__ run -c __CONFIG__
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=__ETC_DIR__ __LOG_DIR__ /run
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
DeviceAllow=/dev/net/tun rw
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
RestrictSUIDSGID=true
LockPersonality=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=geoproxy-tuic

[Install]
WantedBy=multi-user.target
